<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.unespingresso.controllers.EventosController"
            stylesheets="@css/evento.css">

    <!-- Topo - Barra de navegação -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_RIGHT">
            <Label text="UNESPingresso" styleClass="logo-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" styleClass="welcome-text"/>
            <Button fx:id="btnLogout" text="Sair" styleClass="logout-button">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@Downloads/unespLogo.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- Centro - Lista de eventos -->
    <center>
        <ScrollPane fitToWidth="true">
            <VBox fx:id="eventsContainer" spacing="20" styleClass="events-container">
                <Label text="Eventos Disponíveis" styleClass="section-title"/>

                <!-- ListView será preenchida dinamicamente -->
                <ListView fx:id="listViewEvents" styleClass="events-list">
                    <!-- Remova a tag <cellFactory> com fx:factory -->
                </ListView>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Rodapé -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER">
            <Label text="© 2025 UNESPingresso - Todos os direitos reservados" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>