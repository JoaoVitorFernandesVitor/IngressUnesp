<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.*?>

<?import java.net.URL?>
<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900"
           xmlns="http://javafx.com/javafx/17.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.unespingresso.controllers.CadastroController">

    <stylesheets>
        <URL value="@css/menu.css" />
    </stylesheets>

    <!-- Overlay escuro para melhor contraste -->
    <Region style="-fx-background-color: rgba(0,0,0,0.5);" />

    <!-- Conteúdo principal -->
    <VBox alignment="CENTER" spacing="20">
        <!-- Logo/Cabeçalho -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fitHeight="80" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@Downloads/unespLogo.png" />
                </image>
            </ImageView>
            <Label text="Cadastro de Usuário" style="-fx-text-fill: white;">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
        </VBox>

        <!-- Formulário de Cadastro -->
        <GridPane alignment="CENTER" hgap="10" vgap="15" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 30;">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20"/>
            </padding>

            <!-- Linha 1: Nome Completo -->
            <Label text="Nome Completo:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtFullName" promptText="Digite seu nome completo" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <!-- Linha 2: CPF -->
            <Label text="CPF:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtCPF" promptText="Digite seu CPF (apenas números)" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- Linha 3: E-mail -->
            <Label text="E-mail:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtEmail" promptText="Digite seu e-mail" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <!-- Linha 4: Telefone -->
            <Label text="Telefone:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtPhone" promptText="Digite seu telefone" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <!-- Linha 5: Senha -->
            <Label text="Senha:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <PasswordField fx:id="pwdPassword" promptText="Crie uma senha" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <!-- Linha 6: Confirmar Senha -->
            <Label text="Confirmar Senha:" style="-fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <PasswordField fx:id="pwdConfirmPassword" promptText="Confirme sua senha" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>

        <!-- Botões -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="btnBack" mnemonicParsing="false" text="Voltar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14;">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Downloads/unespLogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnRegister" mnemonicParsing="false" text="Cadastrar" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Downloads/unespLogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Rodapé -->
        <Label text="© 2025 UNESPingresso - Todos os direitos reservados" style="-fx-text-fill: #bdc3c7;">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>
</StackPane>