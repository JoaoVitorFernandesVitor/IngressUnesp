<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="eventCard" styleClass="descricao-card" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pacote.mainapp.controllers.EventCardController">

    <HBox alignment="CENTER_LEFT" spacing="20">
        <ImageView fx:id="imageView" fitHeight="110.0" fitWidth="110.0">
         <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </HBox.margin></ImageView>

        <VBox fx:id="labelContainer" spacing="5" />

        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnBuy" styleClass="buy-button" text="Acessar Evento" />
    </HBox>
</VBox>
