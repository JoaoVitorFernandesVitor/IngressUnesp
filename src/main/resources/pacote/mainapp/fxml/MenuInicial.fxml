<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pacote.mainapp.controllers.LoginController">

<stylesheets>
        <URL value="@../css/menu.css" />
    </stylesheets>


    <!-- Overlay escuro para melhor contraste -->
    <Region style="-fx-background-color:#7d1833;" />

    <!-- Conteúdo principal -->
    <VBox alignment="CENTER" spacing="40">
        <!-- Logo/Cabeçalho -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fitHeight="100" fitWidth="100" pickOnBounds="true" preserveRatio="true">
                <Image url="@../img/unespLogo.png"/>
            </ImageView>
            <Label styleClass="title-text" text="IngressUNESP">
                <font>
                    <Font size="36.0" />
                </font>
            </Label>
            <Label styleClass="subtitle-text" text="Sistema de Compra de Ingressos">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
        </VBox>

        <!-- Botões de Ação -->
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 30;">
            <Button fx:id="btnUserLogin" mnemonicParsing="false" onAction="#goToUserLogin" prefHeight="50" prefWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16;" text="Login como Usuário">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>

            <Button fx:id="btnAdminLogin" mnemonicParsing="false" onAction="#goToUserLogin" prefHeight="50" prefWidth="300" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 16;" text="Login como Administrador">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>

            <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="OU" />

            <Button fx:id="btnRegister" mnemonicParsing="false" onAction="#goToCadastro" prefHeight="50" prefWidth="300" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16;" text="Cadastre-se">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
        </VBox>

        <!-- Rodapé -->
        <Label styleClass="footer-text" text="© 2025 IngressUNESP - Todos os direitos reservados">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>
</StackPane>
