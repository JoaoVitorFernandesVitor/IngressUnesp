<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/eventoDetalhado.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pacote.mainapp.controllers.EventoDetalhadoController" styleClass="anchor-pane">





    <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <VBox alignment="CENTER" spacing="15" styleClass="card">

            <VBox alignment="CENTER_LEFT" prefWidth="600.0" spacing="10">
                <ImageView fx:id="eventoImagem" styleClass="image-view" />
                <Label fx:id="eventoTitulo" styleClass="label-title" text="Título do Evento" />
                <Text fx:id="eventoDescricao" styleClass="text" wrappingWidth="600.0" />
            </VBox>

            <HBox alignment="CENTER" spacing="50" styleClass="hbox">
                <VBox spacing="5">
                    <Label styleClass="label-text" text="Preço:" />
                    <Label fx:id="eventoPreco" styleClass="label-preco" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="label-text" text="Quantidade:" />
                    <Spinner fx:id="quantidadeSpinner" styleClass="spinner" />
                </VBox>
            </HBox>

            <Button fx:id="comprarButton" styleClass="button" onAction="#abrirTelaPagamento" text="Comprar Ingresso" />
            <Button fx:id="btnBack" styleClass="secondary-button" onAction="#goToEventos" text="Voltar">
            </Button>
        </VBox>
    </VBox>
</AnchorPane>
