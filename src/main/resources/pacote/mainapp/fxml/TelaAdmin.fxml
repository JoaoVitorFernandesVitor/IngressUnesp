<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pacote.mainapp.controllers.TelaAdminController">

    <stylesheets>
        <URL value="@../css/menu.css" />
    </stylesheets>

    <!-- Overlay escuro para melhor contraste -->
    <Region style="-fx-background-color:#7d1833;" />

    <!-- Conteúdo principal -->
    <VBox alignment="CENTER" spacing="40">
        <!-- Logo/Cabeçalho -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fitHeight="100" fitWidth="100" pickOnBounds="true" preserveRatio="true">
                <Image url="@../img/unespLogo.png"/>
            </ImageView>
            <Label styleClass="title-text" text="IngressUNESP">
                <font>
                    <Font size="36.0" />
                </font>
            </Label>
            <Label styleClass="subtitle-text" text="Tela de Cadastro">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
            <Label fx:id="labelOlaUsuario" styleClass="hello-text" text="Olá, Usuário!">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </VBox>

        <!-- Botões de Cadastro -->
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 30;">
            <Button fx:id="btnCadastroUsuario" mnemonicParsing="false" onAction="#goToCadastro" prefHeight="50" prefWidth="300" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 16;" text="Cadastrar Usuário">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>

            <Button fx:id="btnCadastroEvento" mnemonicParsing="false" onAction="#goToCadastroEvento" prefHeight="50" prefWidth="300" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 16;" text="Cadastrar Evento">
                <font>
                    <Font size="16.0" />
                </font>
            </Button>
        </VBox>

        <Button fx:id="cancelButton" onAction="#goToMenuInicial" style="-fx-background-color: #e74c3c; -fx-font-size: 16px;-fx-background-radius: 5;-fx-text-fill: white" text="Voltar" />

        <!-- Rodapé -->
        <Label styleClass="footer-text" text="© 2025 IngressUNESP - Todos os direitos reservados">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>
</StackPane>
