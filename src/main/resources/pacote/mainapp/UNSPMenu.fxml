<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.*?>

<?import java.net.URL?>
<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900"
           xmlns="http://javafx.com/javafx/17.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.unespingresso.controllers.MenuController">

<stylesheets>
        <URL value="@css/menu.css" />
    </stylesheets>


    <!-- Overlay escuro para melhor contraste -->
    <Region style="-fx-background-color: rgba(0,0,0,0.5);" />

    <!-- Conteúdo principal -->
    <VBox alignment="CENTER" spacing="40">
        <!-- Logo/Cabeçalho -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fitHeight="100" fitWidth="100" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@Downloads/unespLogo.png" />
                </image>
            </ImageView>
            <Label text="UNESPingresso" style="-fx-text-fill: white;">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
            <Label text="Sistema de Compra de Ingressos" style="-fx-text-fill: #bdc3c7;">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
        </VBox>

        <!-- Botões de Ação -->
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 30;">
            <Button fx:id="btnUserLogin" mnemonicParsing="false" prefHeight="50" prefWidth="300" text="Login como Usuário" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
                <graphic>
                    <ImageView fitHeight="25" fitWidth="25" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Downloads/unespLogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnAdminLogin" mnemonicParsing="false" prefHeight="50" prefWidth="300"
                    text="Login como Administrador"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 16;"
                    >
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
                <graphic>
                    <ImageView fitHeight="25" fitWidth="25" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Downloads/unespLogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Label text="OU" style="-fx-text-fill: white; -fx-font-size: 14;" />

            <Button fx:id="btnRegister" mnemonicParsing="false" prefHeight="50" prefWidth="300" text="Cadastre-se" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16;">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
                <graphic>
                    <ImageView fitHeight="25" fitWidth="25" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@Downloads/unespLogo.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>

        <!-- Rodapé -->
        <Label text="© 2025 UNESPingresso - Todos os direitos reservados" style="-fx-text-fill: #bdc3c7;">
            <font>
                <Font size="12.0" />
            </font>
        </Label>
    </VBox>
</StackPane>